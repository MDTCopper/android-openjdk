#!/bin/bash
if [ "$1" = "--version" ]; then
  echo "${TARGET}-gcc (GCC) 4.9 20140827 (prerelease)"
  echo "Copyright (C) 2014 Free Software Foundation, Inc."
  echo "This is free software; see the source for copying conditions.  There is NO"
  echo "warranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE."
else
  # We report ourselves as gcc, so the JDK picks its gcc toolchain configuration
  # and hands us flags that only gcc understands. clang treats an unknown
  # argument as a hard error, so they have to be dropped here.
  # More can be added without editing this file:
  #   export CLANG_WRAPPER_STRIP_FLAGS="-fno-something"
  strip_flags="${CLANG_WRAPPER_STRIP_FLAGS:--fno-var-tracking-assignments -fno-lifetime-dse -fno-sanitize-address-use-after-return}"

  # In gcc mode the JDK never applies its clang specific -Wno-... suppressions,
  # so warnings from the JDK's own headers flood the build log. Errors are not
  # affected by -w and warnings are not errors here (--disable-warnings-as-errors),
  # so silence them all; set CLANG_WRAPPER_WARN_FLAGS to bring them back, e.g.
  #   export CLANG_WRAPPER_WARN_FLAGS="-Wno-unknown-warning-option"
  # These have to come last: clang lets a later -W flag override an earlier one.
  warn_flags="${CLANG_WRAPPER_WARN_FLAGS:--Wno-unknown-warning-option -w}"

  args=()
  for arg in "$@"; do
    keep=1
    for sf in $strip_flags; do
      if [ "$arg" = "$sf" ]; then
        keep=0
        break
      fi
    done
    if [ "$keep" = "1" ]; then
      args+=("$arg")
    fi
  done

  exec $thecc "${args[@]}" $warn_flags
fi
